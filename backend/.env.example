# ==========================================
# FitAI Backend Environment Variables (.env)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas)
# NOTE: To use Atlas Vector Search ($vectorSearch), use an Atlas cluster (M0 or higher).
# Create a vectorSearch index named "fitai_vector_index" on collection "chunks"
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_fitai_2026_seimens

# OpenAI API Configuration (RAG Pipeline & Embeddings)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google OAuth 2.0 (Google Sign-In / Email Integration)
# Get Client ID from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Google Gemini API Key (Fallback if OpenAI is not provided)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
